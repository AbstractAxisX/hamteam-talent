// Prisma schema — همتیم: پلتفرم استعدادیابی
// Talent discovery platform (arts, sports, cooking, creative skills)
// SQLite backend. Enums modeled as String with app-level validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users (talent members) ─────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  name            String
  isVerifiedBadge Boolean   @default(false)
  isBanned        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         Profile?
  posts           Post[]
  likes           PostLike[]
  connectionsReq  Connection[] @relation("ConnectionRequester")
  connectionsRec  Connection[] @relation("ConnectionReceiver")
  conversationsA  Conversation[] @relation("ConvUserA")
  conversationsB  Conversation[] @relation("ConvUserB")
  messages        Message[]
  notifications   Notification[]
  tickets         Ticket[]
  userCategories  UserCategory[]
  userSkills      UserSkill[]
}

// ─── Admin (separate auth, username+password) ──────────────────
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed
  name      String
  createdAt DateTime @default(now())
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bioShort      String   @default("")
  bioLong       String   @default("")
  avatarUrl     String?
  bannerUrl     String?
  province      String?
  city          String?
  phoneVisible  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resume        Resume?
}

// ─── Category & Skill (admin-managed, with icons) ──────────────
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  iconUrl   String?  // emoji or image URL — admin sets
  order     Int      @default(0)
  createdAt DateTime @default(now())

  skills    Skill[]
  posts     Post[]
  userCats  UserCategory[]
}

model Skill {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  posts      Post[]
  userSkills UserSkill[]

  @@unique([categoryId, name])
}

// ─── User's selected categories & skills (their talents) ───────
model UserCategory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// ─── Resume (portfolio/CV) ─────────────────────────────────────
model Resume {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences  ResumeExperience[]
  educations   ResumeEducation[]
}

model ResumeExperience {
  id           String   @id @default(cuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobTitle     String
  organization String
  startDate    String?
  endDate      String?
  description  String   @default("")
  categoryId   String?
  skillId      String?
  createdAt    DateTime @default(now())
}

model ResumeEducation {
  id          String   @id @default(cuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  year        String?
  description String   @default("")
  createdAt   DateTime @default(now())
}

// ─── Posts (talent showcase) ────────────────────────────────────
model Post {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  skillId    String?
  skill      Skill?    @relation(fields: [skillId], references: [id])
  createdAt  DateTime @default(now())

  media      PostMedia[]
  likes      PostLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([categoryId])
}

model PostMedia {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url    String
  type   String // "image" | "video"
  order  Int    @default(0)
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// ─── Connections (follow/request) ──────────────────────────────
model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
}

// ─── Chat ──────────────────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages  Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// ─── Notifications ─────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "connection_request" | "connection_accepted" | "broadcast" | "chat"
  title     String
  body      String   @default("")
  link      String?
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ─── Tickets ───────────────────────────────────────────────────
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String   // could be user or admin
  isAdmin   Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
}
